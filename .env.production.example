# ===========================================
# Trivia Millionaire - Production Environment
# ===========================================
# Copy this file to .env.production and fill in your values

# Your server's public hostname/IP (replace with your actual domain or IP)
HOST=your-server.example.com

# Solace PubSub+ Cloud Configuration
SOLACE_BROKER_URL=wss://your-broker.messaging.solace.cloud:443
SOLACE_VPN_NAME=your-vpn
SOLACE_USERNAME=your-username
SOLACE_PASSWORD=your-password

# Admin Authentication (CHANGE THIS!)
ADMIN_PASSWORD=your-secure-password-here

# URLs (auto-generated from HOST - modify if using custom ports/paths)
VITE_API_URL=http://${HOST}:4847
VITE_CLIENT_URL=http://${HOST}:4849
VITE_ADMIN_URL=http://${HOST}:4848
CORS_ORIGIN=http://${HOST}:4849,http://${HOST}:4848

# Solace client-side config (same as server)
VITE_SOLACE_BROKER_URL=${SOLACE_BROKER_URL}
VITE_SOLACE_VPN_NAME=${SOLACE_VPN_NAME}
VITE_SOLACE_USERNAME=${SOLACE_USERNAME}
VITE_SOLACE_PASSWORD=${SOLACE_PASSWORD}
