{
  "name": "trivia-millionaire",
  "version": "1.0.0",
  "description": "Real-time multiplayer trivia game powered by Solace PubSub+",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:admin\" \"npm run dev:client\"",
    "dev:fresh": "lsof -ti:3001,5173,5176 | xargs kill -9 2>/dev/null; npm run dev",
    "kill": "lsof -ti:3001,5173,5176 | xargs kill -9 2>/dev/null",
    "dev:server": "npm run dev --workspace=@trivia-millionaire/server",
    "dev:admin": "npm run dev --workspace=@trivia-millionaire/admin",
    "dev:client": "npm run dev --workspace=@trivia-millionaire/client",
    "build": "npm run build --workspaces",
    "build:server": "npm run build --workspace=@trivia-millionaire/server",
    "build:admin": "npm run build --workspace=@trivia-millionaire/admin",
    "build:client": "npm run build --workspace=@trivia-millionaire/client",
    "start": "npm run start --workspace=@trivia-millionaire/server",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
