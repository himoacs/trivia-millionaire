# Solace PubSub+ Broker Configuration
SOLACE_BROKER_URL=ws://localhost:8008
SOLACE_VPN_NAME=default
SOLACE_USERNAME=default
SOLACE_PASSWORD=default

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Admin Authentication
ADMIN_PASSWORD=admin123

# AI Service Configuration (for question generation)
# NOTE: Users can provide their own API keys through the admin UI when generating questions
# If you want a server default, uncomment and configure one of these providers:

# OpenAI
# OPENAI_API_KEY=your-openai-api-key

# Anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key

# LiteLLM Configuration (RECOMMENDED - supports multiple providers)
# LITELLM_BASE_URL=https://lite-llm.mymaas.net
# LITELLM_API_KEY=your-litellm-api-key
# LITELLM_MODEL=bedrock-claude-4-5-sonnet
# Options: gpt-4, gpt-3.5-turbo, claude-3-opus-20240229, claude-3-sonnet-20240229
