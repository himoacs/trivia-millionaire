# Solace PubSub+ Broker Configuration
SOLACE_BROKER_URL=ws://localhost:8008
SOLACE_VPN_NAME=default
SOLACE_USERNAME=default
SOLACE_PASSWORD=default

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Admin Authentication
ADMIN_PASSWORD=admin123

# AI Service Configuration (for question generation)
# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# LiteLLM Configuration
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=your-litellm-api-key
LITELLM_MODEL=gpt-3.5-turbo
# Options: gpt-4, gpt-3.5-turbo, claude-3-opus-20240229, claude-3-sonnet-20240229
